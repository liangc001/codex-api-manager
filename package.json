{
  "name": "codex-api-manager",
  "version": "1.0.54",
  "private": true,
  "type": "module",
  "description": "Local Windows API switchboard for Codex and Claude Code",
  "author": "API Switchboard",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "desktop": "node desktop/prepare.mjs && electron .",
    "build:exe": "npm run vpn:build && node desktop/prepare.mjs && electron-builder --win portable --x64 --publish never",
    "vpn:build": "node vpn/build.mjs",
    "vpn:fixture": "node vpn/build.mjs --fixture",
    "vpn:bundle": "node vpn/pack-bundle.mjs",
    "build:vpn-preview": "npm run vpn:build && node desktop/prepare.mjs && electron-builder --win portable --x64 --publish never",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "toml-eslint-parser": "1.0.3",
    "lucide": "0.468.0"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.codex.api.manager",
    "productName": "API Switchboard",
    "executableName": "Codex API Manager",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/restart-codex.cjs",
      "desktop/monitor-transport.cjs",
      "desktop/vpn-client.cjs",
      "desktop/access-config.cjs",
      "desktop/access-check.cjs",
      "desktop/access-window.cjs",
      "desktop/access-preload.cjs",
      "desktop/access-memory.cjs",
      "desktop/vpn-bundle.cjs",
      "core.mjs",
      "claude.mjs",
      "monitor.mjs",
      "storage.mjs",
      "portable.mjs",
      "models.mjs",
      "transfer.mjs",
      "support.mjs",
      "session-repair.mjs",
      "auto-session-repair.mjs",
      "updater.mjs",
      "public/**",
      "!public/v2/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      { "from": "vpn/artifacts/broker", "to": "vpn", "filter": ["Switchboard.Vpn.exe"] },
      { "from": "vpn/artifacts/distribution", "to": "vpn", "filter": ["bootstrap.enc"] },
      { "from": "vpn/licenses", "to": "vpn/licenses", "filter": ["*-LICENSE.txt"] }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "compression": "normal",
    "portable": {
      "useZip": true,
      "artifactName": "Codex-API-Manager.exe"
    }
  }
}
