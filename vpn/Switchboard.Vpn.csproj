<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Switchboard.Vpn</AssemblyName>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VpnFixtures)' == 'true'">
    <DefineConstants>$(DefineConstants);VPN_FIXTURES</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(VpnFixtures)' != 'true'">
    <Compile Remove="backend/*Tests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
</Project>
